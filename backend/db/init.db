-- Inicialització de la Base de Dades per a L'Últim Tamarro

-- Crear la taula de puntuacions per temps si encara no existeix
CREATE TABLE IF NOT EXISTS puntuacions_temps (
    id SERIAL PRIMARY KEY,
    nom_usuari VARCHAR(50) NOT NULL,
    temps_jugat INTEGER NOT NULL,
    data_partida TIMESTAMP WITH TIME ZONE DEFAULT NOW() NOT NULL
);

-- Crear la taula de puntuacions per enemics derrotats si encara no existeix
CREATE TABLE IF NOT EXISTS puntuacions_enemics (
    id SERIAL PRIMARY KEY,
    nom_usuari VARCHAR(50) NOT NULL,
    enemics_derrotats INTEGER NOT NULL,
    data_partida TIMESTAMP WITH TIME ZONE DEFAULT NOW() NOT NULL
);

-- Crear índexs per millorar el rendiment de les consultes
CREATE INDEX IF NOT EXISTS idx_temps_nom_usuari ON puntuacions_temps(nom_usuari);
CREATE INDEX IF NOT EXISTS idx_temps_jugat ON puntuacions_temps(temps_jugat);
CREATE INDEX IF NOT EXISTS idx_temps_data ON puntuacions_temps(data_partida);

CREATE INDEX IF NOT EXISTS idx_enemics_nom_usuari ON puntuacions_enemics(nom_usuari);
CREATE INDEX IF NOT EXISTS idx_enemics_derrotats ON puntuacions_enemics(enemics_derrotats);
CREATE INDEX IF NOT EXISTS idx_enemics_data ON puntuacions_enemics(data_partida);

