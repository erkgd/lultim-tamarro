-- Inicialització de la Base de Dades per a L'Últim Tamarro

-- Crear la taula de puntuacions si encara no existeix
CREATE TABLE IF NOT EXISTS puntuacions (
    id SERIAL PRIMARY KEY,
    nom_usuari VARCHAR(50) NOT NULL,
    tiemps_jugat INTEGER NOT NULL,
    enemics_derrotats INTEGER NOT NULL,
    data_partida TIMESTAMP WITH TIME ZONE DEFAULT NOW() NOT NULL
);

-- Crear índexs per millorar el rendiment de les consultes
CREATE INDEX IF NOT EXISTS idx_puntuacions_nom_usuari ON puntuacions(nom_usuari);
CREATE INDEX IF NOT EXISTS idx_puntuacions_tiemps_jugat ON puntuacions(tiemps_jugat);
CREATE INDEX IF NOT EXISTS idx_puntuacions_enemics_derrotats ON puntuacions(enemics_derrotats);

