# Aquest fitxer és llegit per docker-compose.yml si les variables no estan ja definides a l'entorn
# o per python-dotenv si l'apliació s'executa localment fora de compose.

# Per a la connexió de la API a la BD dins de Docker Compose (injectat per docker-compose)
DATABASE_URL=postgresql://tamarro_user:tamarro_password@db:5432/tamarro_db

# Variables per a la configuració del contenidor PostgreSQL (usades directament per docker-compose)
POSTGRES_USER=tamarro_user
POSTGRES_PASSWORD=tamarro_password # Moure a secrets en producció!
POSTGRES_DB=tamarro_db

# Altres variables per a l'API (exemple)
# API_LOG_LEVEL=INFO